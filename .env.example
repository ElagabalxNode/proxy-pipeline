# ============================================
# PROXY PIPELINE — СЕКРЕТЫ / ENV (шаблон)
# ============================================
# cp .env.example .env  →  заполни секреты  →  source .env  (перед terraform / pipelinectl)
# Блок «КАНОНИЧЕСКИЕ имена» внизу экспортирует то, что инструменты реально читают.
# Не-секреты (регион/план/порты) задаются в terraform.tfvars и config/pipeline.yaml.

# --- Cherry Servers (Exit-нода) ---
CHERRY_API_TOKEN=""
CHERRY_PROJECT_ID=""
EXIT_REGION="NL-Amsterdam"              # справочно; авторитет — terraform.tfvars
EXIT_PLAN="B1-1-1gb-20s-shared"
EXIT_IMAGE="ubuntu_24_04_64bit"

# --- Bridge (справочно; IP/настройки приходят из terraform output) ---
BRIDGE_IP=""
BRIDGE_SSH_USER="root"                  # Timeweb bridge = root; Yandex = ubuntu
BRIDGE_SSH_PORT="22"
BRIDGE_SSH_KEY="~/.ssh/proxy_pipeline"

# --- 3X-UI ---
PANEL_PORT="2053"
PANEL_USER="admin"
PANEL_PASS=""
PANEL_PATH="/secretpanel"

# --- VLESS + Reality / Shadowsocks / Chain (справочно) ---
REALITY_SNI="www.microsoft.com"
REALITY_PORT="443"
SS_PORT="8388"
SS_METHOD="2022-blake3-aes-128-gcm"
CHAIN_PORT="8443"

# --- Telegram алерты (опционально) ---
TG_BOT_TOKEN=""
TG_CHAT_ID=""

# --- SSH ---
SSH_PRIVATE_KEY_PATH="~/.ssh/proxy_pipeline"
SSH_PUBLIC_KEY_PATH="~/.ssh/proxy_pipeline.pub"

# ============================================
# КАНОНИЧЕСКИЕ имена — их РЕАЛЬНО читают terraform и pipelinectl.
# Подгрузка одной командой:   source .env     (затем terraform / pipelinectl)
# ============================================
export TF_VAR_cherry_api_token="$CHERRY_API_TOKEN"
export TF_VAR_panel_pass="$PANEL_PASS"
export PROXY_PIPELINE_PANEL_PASS="$PANEL_PASS"

# Timeweb Cloud (мост). Токен: панель → «API и Terraform».
# У токена ВКЛЮЧИ «удалять сервисы по API без кода в Телеграме» (иначе destroy/rotate зависнут).
export TWC_TOKEN=""

# Опционально — Telegram (управление/алерты pipelinectl):
# export TELEGRAM_BOT_TOKEN="$TG_BOT_TOKEN"
# export TELEGRAM_NOTIFY_CHAT_ID="$TG_CHAT_ID"

# Опционально — Yandex bridge (legacy):
# export YC_TOKEN=""
