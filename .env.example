# ============================================
# PROXY PIPELINE — КОНФИГУРАЦИЯ (Cherry Servers)
# ============================================
# cp .env.example .env && nano .env

# --- Cherry Servers (Exit-нода) ---
# API token: portal.cherryservers.com → Settings → API Keys
CHERRY_API_TOKEN="your-cherry-api-token"
CHERRY_PROJECT_ID="123456"              # Project ID из панели Cherry

# Регионы: EU-Nord-1 (Stockholm), NL-Ams-1 (Amsterdam), 
#          EU-East-1 (Lithuania), DE-Fra-1 (Frankfurt)
EXIT_REGION="EU-Nord-1"
EXIT_PLAN="cloud_vps_1"                 # 1vCPU/1GB/20GB ~$6/мес
EXIT_IMAGE="ubuntu_24_04_64bit"

# --- Bridge VPS (RU-хостинг, ручной setup) ---
BRIDGE_IP="your-bridge-ip"
BRIDGE_SSH_USER="root"
BRIDGE_SSH_PORT="22"
BRIDGE_SSH_KEY="~/.ssh/proxy_pipeline"

# --- 3X-UI ---
PANEL_PORT="2053"
PANEL_USER="admin"
PANEL_PASS="$(openssl rand -hex 16)"
PANEL_PATH="/secretpanel"

# --- VLESS + Reality ---
REALITY_SNI="www.microsoft.com"
REALITY_PORT="443"

# --- Shadowsocks-2022 ---
SS_PORT="8388"
SS_METHOD="2022-blake3-aes-128-gcm"

# --- Chain (Bridge → Exit) ---
CHAIN_PORT="8443"

# --- Telegram алерты (опционально) ---
TG_BOT_TOKEN=""
TG_CHAT_ID=""

# --- SSH ---
SSH_PRIVATE_KEY_PATH="~/.ssh/proxy_pipeline"
SSH_PUBLIC_KEY_PATH="~/.ssh/proxy_pipeline.pub"
