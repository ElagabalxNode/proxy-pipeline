# Copy to .env (gitignored) only if you still run legacy scripts.
# Preferred: config/pipeline.yaml + PROXY_PIPELINE_* env vars (see docs/PIPELINE.md).

CHERRY_API_TOKEN=""
CHERRY_PROJECT_ID=""
EXIT_REGION="SE-Stockholm"
EXIT_PLAN="B1-1-1gb-20s-shared"
EXIT_IMAGE="ubuntu_24_04_64bit"

BRIDGE_IP=""
BRIDGE_SSH_USER="ubuntu"
BRIDGE_SSH_PORT="22"
BRIDGE_SSH_KEY="~/.ssh/proxy_pipeline"

PANEL_PORT="2053"
PANEL_USER="admin"
PANEL_PASS=""
