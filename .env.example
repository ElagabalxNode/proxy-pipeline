# Secrets of the pipeline. cp .env.example .env, fill in, then before pipelinectl/terraform:
#   set -a; . ./.env; set +a          (scripts/rotate-chain.sh loads .env by itself)
# .env is gitignored. Non-secret settings live in config/pipeline.yaml and terraform/terraform.tfvars.

# Cherry Servers (Exit): portal -> API keys
CHERRY_API_TOKEN=""
TF_VAR_cherry_api_token="$CHERRY_API_TOKEN"

# Password of the 3X-UI panel on the Exit (choose one; Terraform sets it on a new Exit)
PROXY_PIPELINE_PANEL_PASS=""
TF_VAR_panel_pass="$PROXY_PIPELINE_PANEL_PASS"

# Timeweb Cloud: A records of the bridge domain and the DNS-01 certificate
# (panel -> "API и Terraform"; the token needs access to DNS)
TIMEWEBCLOUD_AUTH_TOKEN=""

# Optional: VDSina API for scripts/vdsina_ip.py (account overview, address check)
VDSINA_API_TOKEN=""

# Optional alert channels (see alerts: in config/pipeline.yaml)
# TELEGRAM_BOT_TOKEN=""
# PROXY_PIPELINE_SMTP_PASS=""
# PROXY_PIPELINE_SMSRU_API_ID=""
