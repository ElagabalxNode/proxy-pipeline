{
  "bridge_ip": "{{ ansible_host }}",
  "uuid": "{{ bridge_client_uuid }}",
  "private_key": "{{ bridge_private_key }}",
  "public_key": "{{ bridge_public_key }}",
  "short_id": "{{ bridge_short_id }}",
  "sni": "{{ bridge_reality_sni }}",
  "dest": "{{ bridge_reality_dest }}",
  "ss_method": "{{ bridge_ss_method }}",
{% if bridge_xhttp_enabled %}
  "xhttp_uuid": "{{ bridge_xhttp_uuid }}",
  "xhttp_path": "{{ bridge_xhttp_path }}",
{% endif %}
  "ss_password": "{{ bridge_ss_password }}"
}
